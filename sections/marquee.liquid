<!-- sections/marquee.liquid -->
<style>
  .marquee-container {
    background-color: {{ section.settings.color_background | default: '#000000' }};
    color: {{ section.settings.color_text | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 10 }}px 0 {{ section.settings.padding_bottom | default: 10 }}px 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .marquee-content {
    display: inline-block;
    padding-left: 100%;
    animation: marquee-scroll {{ section.settings.speed | default: 20 }}s linear infinite;
  }

  .marquee-item {
    display: inline-block;
    font-size: {{ section.settings.font_size | default: 16 }}px;
    padding: 0 {{ section.settings.spacing | default: 50 }}px;
    vertical-align: middle;
    {% if section.settings.link != blank %}
      text-decoration: none;
      color: inherit;
    {% endif %}
  }

  /* Divider Styles */
  .marquee-divider {
    display: inline-block;
    font-size: {{ section.settings.font_size | default: 16 }}px;
    opacity: 0.7;
    user-select: none;
  }

  .marquee-divider.line {
    width: {{ section.settings.divider_thickness | default: 1 }}px;
    height: {{ section.settings.divider_height | default: 16 }}px;
    background-color: {{ section.settings.color_text | default: '#ffffff' }};
    margin: 0 {{ section.settings.divider_spacing | default: 20 }}px;
    vertical-align: middle;
  }

  .marquee-item:hover {
    opacity: 0.8;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

<div class="marquee-container">
  <div class="marquee-content">
    {%- for block in section.blocks -%}
        {%- if section.settings.divider_position == "before" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider line"></span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
      
      <span class="marquee-item">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" target="{{ section.settings.link_target }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>

        {%- if section.settings.divider_position == "after" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider line"></span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
    {%- for block in section.blocks -%}

        {%- if section.settings.divider_position == "before" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider line"></span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}

      <span class="marquee-item">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" target="{{ section.settings.link_target }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>

        {%- if section.settings.divider_position == "after" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider line"></span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Text",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Item Spacing",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Divider Options"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "character", "label": "Character (e.g., |, •)" },
        { "value": "Icon", "label": "Icon" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "divider_position",
      "label": "Divider Position",
      "options": [
        { "value": "before", "label": "Before" },
        { "value": "after", "label": "After" }
      ],
      "default": "after",
      "visible_if": "{{ section.settings.divider_style != 'none' }}"
    },
    {
      "type": "text",
      "id": "divider_char",
      "label": "Divider Character",
      "default": "|",
      "info": "Used only if 'Character' style is selected.",
      "visible_if": "{{ section.settings.divider_style == 'character' }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Character Size",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Used only if 'Vertical Line' style is selected.",
      "visible_if": "{{ section.settings.divider_style == 'character' }}"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider Spacing",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "info": "Horizontal space around the divider."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL (Optional)"
    },
    {
      "type": "select",
      "id": "link_target",
      "label": "Link Target",
      "options": [
        { "value": "_self", "label": "Same Tab" },
        { "value": "_blank", "label": "New Tab" }
      ],
      "default": "_self"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your Marquee Text Here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Text",
      "blocks": [
        { "type": "text" },
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}