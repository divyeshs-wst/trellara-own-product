<!-- sections/marquee.liquid -->
<style>
  .marquee-container {
    background-color: {{ section.settings.color_background | default: '#000000' }};
    padding: {{ section.settings.padding_top | default: 10 }}px 0 {{ section.settings.padding_bottom | default: 10 }}px 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .marquee-content {
    display: inline-flex;
    animation: marquee-scroll {{ section.settings.speed | default: 20 }}s linear infinite;
  }

  .marquee-item,
  .marquee-item a {
    color: {{ section.settings.color_text | default: '#ffffff' }};
    display: inline-block;
    font-size: {{ section.settings.font_size | default: 16 }}px;
    padding: 0 {{ section.settings.spacing | default: 50 }}px;
    vertical-align: middle;
    text-decoration: none;
  }

  .marquee-divider {
    {% if section.settings.divider_border_show == 'show' %}
      border: {{ section.settings.divider_border_width | default: 0 }}px {{ section.settings.divider_border_type | default: "solid" }} {{ section.settings.divider_border_color | default: "#000" }};
      border-radius: {{ section.settings.divider_border_radius | default: 0 }}px;
    {% endif %}
  }

  /* Divider Styles */
  .marquee-divider {
    display: inline-flex;
    font-size: {{ section.settings.font_size | default: 16 }}px;
    opacity: 0.7;
    user-select: none;
    align-items: center;
    flex-direction: row;
    width: max-content;
  }

  .marquee-divider-icon img {
    width: {{ section.settings.icon_size | append: 'px' | default: "auto" }};
    margin: 0 {{ section.settings.divider_spacing | default: 20 }}px;
  }

  .marquee-item:hover {
    opacity: 0.8;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

<div class="marquee-container">
  <div class="marquee-content">
    {%- for block in section.blocks -%}
        {%- if section.settings.divider_position == "before" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider marquee-divider-icon">
              {% if section.settings.icon_image != blank %}
                {{
                  section.settings.icon_image
                  | image_url: width: auto
                  | image_tag: loading: 'lazy', alt: section.settings.icon_image.alt
                }}
              {%  endif %}
            </span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
      
      <span class="marquee-item">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>

        {%- if section.settings.divider_position == "after" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider marquee-divider-icon">
              {% if section.settings.icon_image != blank %}
                {{
                  section.settings.icon_image
                  | image_url: width: auto
                  | image_tag: loading: 'lazy', alt: section.settings.icon_image.alt
                }}
              {%  endif %}
            </span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
    {%- for block in section.blocks -%}

        {%- if section.settings.divider_position == "before" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider marquee-divider-icon">
                {% if section.settings.icon_image != blank %}
                  {{
                    section.settings.icon_image
                    | image_url: width: auto
                    | image_tag: loading: 'lazy', alt: section.settings.icon_image.alt
                  }}
                {%  endif %}
            </span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}

      <span class="marquee-item">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
            {{ block.settings.text | escape }}
          </a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>

        {%- if section.settings.divider_position == "after" -%}
            {%- if section.settings.divider_style == 'icon' -%}
            <span class="marquee-divider marquee-divider-icon">
              {% if section.settings.icon_image != blank %}
                {{
                  section.settings.icon_image
                  | image_url: width: auto
                  | image_tag: loading: 'lazy', alt: section.settings.icon_image.alt
                }}
              {%  endif %}
            </span>
            {%- elsif section.settings.divider_style == 'character' and section.settings.divider_char != blank -%}
            <span class="marquee-divider">{{ section.settings.divider_char }}</span>
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Text",
  "class": "trop-marquee-section",
  "settings": [
    {
      "type": "color",
      "id": "color_background",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Item Spacing",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Divider Options"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "character", "label": "Character (e.g., |, •)" },
        { "value": "icon", "label": "Icon" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "divider_position",
      "label": "Divider Position",
      "options": [
        { "value": "before", "label": "Before" },
        { "value": "after", "label": "After" }
      ],
      "default": "after",
      "visible_if": "{{ section.settings.divider_style != 'none' }}"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image",
      "visible_if": "{{ section.settings.divider_style == 'icon' }}"
    },
    {
      "type": "text",
      "id": "divider_char",
      "label": "Divider Character",
      "default": "|",
      "info": "Used only if 'Character' style is selected.",
      "visible_if": "{{ section.settings.divider_style == 'character' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 10,
      "max": 101,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.divider_style == 'icon' }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Character Size",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "info": "Used only if 'Vertical Line' style is selected.",
      "visible_if": "{{ section.settings.divider_style == 'character' }}"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider Spacing",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "info": "Horizontal space around the divider."
    },
    {
      "type": "select",
      "id": "divider_border_show",
      "label": "Divider Border",
      "options": [
        {
          "value": "hide",
          "label": "Hide"
        },
        {
          "value": "show",
          "label": "Show"
        }
      ],
      "default": "show"
    },
    {
      "type": "range",
      "id": "divider_border_width",
      "label": "Divider Border Width",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.divider_border_show == 'show' }}"
    },
 
    {
      "type": "select",
      "id": "divider_border_type",
      "label": "Divider Border Type",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        },
        {
          "value": "groove",
          "label": "Groove"
        },
        {
          "value": "inset",
          "label": "Inset"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.divider_border_show == 'show' }}"
    },
    {
      "type": "range",
      "id": "divider_border_radius",
      "label": "Divider Border Radius",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.divider_border_show == 'show' }}"
    },
    {
      "type": "color",
      "id": "divider_border_color",
      "label": "Divider Border Color",
      "default": "#000000",
      "visible_if": "{{ section.settings.divider_border_show == 'show' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your Marquee Text Here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (Optional)"
        },
        {
          "type": "select",
          "id": "link_target",
          "label": "Link Target",
          "options": [
            { "value": "_self", "label": "Same Tab" },
            { "value": "_blank", "label": "New Tab" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Text",
      "blocks": [
        { 
          "type": "text"
        },
        { 
          "type": "text"
        },
        { 
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}