{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0

  assign hero_height = 'auto'

  if s.hero_height == 'small'
    assign hero_height = '400px'
  elsif s.hero_height == 'medium'
    assign hero_height = '600px'
  elsif s.hero_height == 'large'
    assign hero_height = '800px'
  elsif s.hero_height == 'full'
    assign hero_height = '100vh'
  endif
-%}

{% style %}
  .trop-hero {
    min-height: {{ hero_height }};
    position: relative;
    overflow: hidden;
  }
{% endstyle %}

<section class="trop-hero">
  <div class="trop-hero__media">
    {% if s.background_type == 'video' and s.video != blank %}
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}

    {% elsif s.desktop_image != blank %}
      <picture>
        {% if s.mobile_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="
              {{ s.mobile_image | image_url: width: 375 }} 375w,
              {{ s.mobile_image | image_url: width: 550 }} 550w,
              {{ s.mobile_image | image_url: width: 750 }} 750w,
              {{ s.mobile_image | image_url: width: 900 }} 900w
            "
            sizes="100vw"
          >
        {% endif %}

        {{
          s.desktop_image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '750,1100,1500,2000',
            sizes: '100vw',
            alt: s.desktop_image.alt
        }}
      </picture>
    {% endif %}
  </div>

  {% if s.enable_overlay %}
    <div class="trop-hero__overlay"></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Hero Layout"
    },

    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full Screen"
        }
      ],
      "default": "medium"
    },

    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },

    {
      "type": "header",
      "content": "Overlay"
    },

    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable Overlay",
      "default": true
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Small Heading"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Your Hero Heading"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width",
      "min": 300,
      "max": 1000,
      "step": 50,
      "default": 600,
      "unit": "px"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Horizontal Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Heading Style"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 52,
      "unit": "px"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
  ],

  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}