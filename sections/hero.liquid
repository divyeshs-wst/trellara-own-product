{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0

  assign hero_height = 'auto'

  if s.hero_height == 'small'
    assign hero_height = '400px'
  elsif s.hero_height == 'medium'
    assign hero_height = '600px'
  elsif s.hero_height == 'large'
    assign hero_height = '800px'
  elsif s.hero_height == 'full'
    assign hero_height = '100vh'
  endif
-%}

{% style %}
  .trop-hero {
    max-height: {{ hero_height }};
    position: relative;
    overflow: hidden;
  }
  .trop-hero__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    Background-color: var(--hero-overlay-color, #000);
    opacity: var(--hero-overlay-opacity, 0.5);
  }
  .trop-hero__container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-content: center;
  }

  .trop-hero__content {
    max-width: {{ s.content_width }}px;
    text-align: {{ s.text_alignment }};
  }

  .trop-hero__subheading {
    color: {{ s.heading_color }};
  }

  .trop-hero__content h1 {
    color: {{ s.heading_color }};
    font-size: {{ s.heading_size }}px;
  }

  .trop-hero__content p {
    color: {{ s.description_color }};
  }

  .trop-hero__button {
    background: {{ s.button_bg }};
    color: {{ s.button_color }};
    border-radius: {{ s.button_radius }}px;
  }

  .trop-hero__button:hover {
    background: {{ s.button_hover_bg }};
    color: {{ s.button_hover_color }};
  }
{% endstyle %}

<section class="trop-hero">
  <div class="trop-hero__media">
    {% if s.background_type == 'video' and s.video != blank %}
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}

    {% elsif s.desktop_image != blank %}
      <picture>
        {% if s.mobile_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="
              {{ s.mobile_image | image_url: width: 375 }} 375w,
              {{ s.mobile_image | image_url: width: 550 }} 550w,
              {{ s.mobile_image | image_url: width: 750 }} 750w,
              {{ s.mobile_image | image_url: width: 900 }} 900w
            "
            sizes="100vw"
          >
        {% endif %}

        {{
          s.desktop_image
          | image_url: width: 2000
          | image_tag: loading: 'lazy', widths: '750,1100,1500,2000', sizes: '100vw', alt: s.desktop_image.alt
        }}
      </picture>
    {% endif %}
  </div>

  {% if s.enable_overlay %}
    <div
      class="trop-hero__overlay"
      style="--hero-overlay-color: {{ s.overlay_color }};--hero-overlay-opacity: {{ overlay_opacity }};"
    ></div>
  {% endif %}

  <div class="trop-hero__container">
    <div class="trop-hero__content trop-hero__content--{{ s.horizontal_position }} trop-hero__content--{{ s.vertical_position }}">
      {% if s.subheading != blank %}
        <span class="trop-hero__subheading">{{ s.subheading }}</span>
      {% endif %}

      {% if s.heading != blank %}
        <h1>{{ s.heading }}</h1>
      {% endif %}

      {% if s.description != blank %}
        <div class="trop-hero__description">{{ s.description }}</div>
      {% endif %}

      <div class="trop-hero__buttons">
        {% if s.button_text != blank %}
          <a href="{{ s.button_link }}" class="trop-hero__button">{{ s.button_text }}</a>
        {% endif %}

        {% if s.button_text_2 != blank %}
          <a href="{{ s.button_link_2 }}" class="trop-hero__button trop-hero__button--secondary">
            {{- s.button_text_2 -}}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Hero Layout"
    },

    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full Screen"
        }
      ],
      "default": "medium"
    },

    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },

    {
      "type": "header",
      "content": "Background Overlay"
    },

    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable Overlay",
      "default": true
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Small Heading"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Your Hero Heading"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width",
      "min": 300,
      "max": 1000,
      "step": 50,
      "default": 600,
      "unit": "px"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Horizontal Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Sub Heading Style"
    },
    {
      "type": "select",
      "id": "sub_heading_tag",
      "label": "Sub Heading Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        },
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "sub_heading_size",
      "label": "Sub Heading Font Size",
      "min": 8,
      "max": 100,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "sub_heading_color",
      "label": "Sub Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Style"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        },
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 52,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Description Style"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size",
      "min": 8,
      "max": 100,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    }
  ],

  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}