{{ 'collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign container_class = 'container'
  if s.container_width == 'no-container'
    assign container_class = 'no-container'
  endif

  assign track_class = 'trop-collection-list__track'
  if s.layout_style == 'grid'
    assign track_class = track_class | append: ' trop-collection-list__track--grid'
  endif

  assign wrapper_class = 'trop-collection-list__wrapper'
  if s.cards_width == 'full-width' and s.container_width == 'container'
    assign wrapper_class = wrapper_class | append: ' trop-collection-list__wrapper--bleed-right'
  elsif s.cards_width == 'container' and s.container_width == 'no-container'
    assign wrapper_class = wrapper_class | append: ' trop-collection-list__wrapper--contained'
  endif

  assign label_class = 'trop-collection-list__label trop-collection-list__label--' | append: s.label_position

  assign arrow_shape_class = 'trop-collection-list__arrow trop-collection-list__arrow--' | append: s.arrow_style
-%}

{% style %}
  .trop-collection-list-{{ section.id }} .trop-icon {
        width: 56px;
        height: 56px;
    }

    .trop-collection-list-{{ section.id }} .trop-icon img {
        width: 16px;
        height: auto;
    }

  .trop-collection-list-{{ section.id }} .trop-wcu {
    display: flex;
    justify-content: space-between;
  }

  .trop-collection-list-{{ section.id }} a.trop-card-link svg {
    width: auto;
    height: auto;
  }

  .trop-collection-list-{{ section.id }} {
    background-color: {{ s.section_bg_color }};
    padding-top: {{ s.section_padding_top }}px;
    padding-bottom: {{ s.section_padding_bottom }}px;
    padding-right: 15px;
    padding-left: 15px;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__header--top {
    justify-content: {% if s.arrow_position == 'top' %}{{ s.arrow_space }}{% else %}flex-start{% endif %};
  }

  /* Bottom header: only holds arrows (if arrow_position = bottom). */
  .trop-collection-list-{{ section.id }} .trop-collection-list__header--bottom {
    justify-content: {% if s.arrow_position == 'bottom' %}{{ s.arrow_bottom_align }}{% else %}flex-start{% endif %};
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__heading {
    color: {{ s.heading_color }};
    font-size: {{ s.heading_size }}px;
    text-transform: {{ s.heading_transform }};
    text-align: {{ s.heading_alignment }};
    flex: max-content;
  }
  
  .trop-collection-list-{{ section.id }} .trop-collection-list__sub_heading {
    color: {{ s.sub_heading_color }};
    font-size: {{ s.sub_heading_size }}px;
    text-transform: {{ s.sub_heading_transform }};
    text-align: {{ s.sub_heading_alignment }};
    flex: max-content;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__track {
    gap: {{ s.item_gap }}px;
  }

  .trop-collection-list-{{ section.id }} {
    --trop-columns-desktop: {{ s.columns_desktop }};
    --trop-columns-mobile: {{ s.columns_mobile }};
    --trop-item-width-desktop: {{ s.item_width_desktop }}px;
    --trop-item-width-mobile: {{ s.item_width_mobile }}px;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__card-inner {
    background-color: {{ s.card_bg_color }};
    border-radius: {{ s.card_border_radius }}px;
    padding: 24px;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__image-wrap {
    border-radius: {{ s.image_border_radius }}px;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__image-wrap img {
    height: auto;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__label {
    color: {{ s.label_color }};
    font-size: {{ s.label_size }}px;
    font-weight: {{ s.label_font_weight }};
    text-transform: {{ s.label_transform }};
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__label--overlay {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    height: calc(100% - 24px);
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__label--overlay::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 80%), rgba(0, 0, 0, 0));
    z-index: -1;
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__arrow {
    width: {{ s.arrow_size }}px;
    height: {{ s.arrow_size }}px;
    background-color: {{ s.arrow_bg_color }};
  }

  .trop-collection-list-{{ section.id }} .trop-collection-list__arrow svg {
    fill: {{ s.arrow_icon_color }};
  }
{% endstyle %}

<section class="trop-collection-list trop-collection-list-{{ section.id }}">
  <div class="{{ container_class }}">
    <div class="trop-collection-list__inner">

        <div class="trop-collection-list__header trop-collection-list__header--top trop-flex mb-25">
        <div class="trop-collection-list-content">
            {% if s.sub_heading != blank %}
            <{{ s.sub_heading_tag }} class="trop-collection-list__sub_heading">{{ s.sub_heading }}</{{ s.sub_heading_tag }}>
            {% endif %}
            {% if s.heading != blank %}
            <{{ s.heading_tag }} class="trop-collection-list__heading">{{ s.heading }}</{{ s.heading_tag }}>
            {% endif %}
        </div>

        {% if s.arrow_position == 'top' and s.layout_style == 'carousel' and s.enable_arrows %}
            <div class="trop-collection-list__nav">
            <button
                type="button"
                class="{{ arrow_shape_class }}"
                data-trop-prev
                aria-label="Previous"
            >
                <svg viewBox="0 0 24 24"><path d="M15.5 4.5 8 12l7.5 7.5 1.5-1.5L11 12l6-6z"/></svg>
            </button>
            <button
                type="button"
                class="{{ arrow_shape_class }}"
                data-trop-next
                aria-label="Next"
            >
                <svg viewBox="0 0 24 24"><path d="M8.5 4.5 16 12l-7.5 7.5L7 18l6-6-6-6z"/></svg>
            </button>
            </div>
        {% endif %}
        </div>

        <div class="{{ wrapper_class }}">
        <div class="{{ track_class }}" data-trop-track>
            {% for block in section.blocks %}
                {%- liquid
                    assign block_settings = block.settings
                    assign the_collection = block_settings.collection

                    assign card_title = block_settings.custom_title
                    if card_title == blank and the_collection != blank
                    assign card_title = the_collection.title
                    endif
                    
                    assign card_description = block_settings.custom_description
                    if card_description == blank and the_collection != blank
                    assign card_description = the_collection.description
                    endif

                    assign card_text = block_settings.custom_link_text
                    if card_text == blank and the_collection != blank
                    assign card_text = the_collection.title
                    endif
                    
                    assign card_link = block_settings.custom_link
                    if card_link == blank and the_collection != blank
                    assign card_link = the_collection.url
                    endif

                    assign card_image = block_settings.custom_image
                    if card_image == blank and the_collection != blank
                    assign card_image = the_collection.image
                    endif
                -%}

                <div class="trop-collection-list__card" {{ block.shopify_attributes }}>
                    <div class="trop-collection-list__card-inner">
                        <div class="trop-collection-list__image-wrap">
                            <div class="trop-flex trop-wcu">
                                <div class="trop-icon">
                                    {% if card_image != blank %}
                                        {{
                                            card_image
                                            | image_url: width: 800
                                            | image_tag: loading: 'lazy', widths: '300,450,600,800', sizes: '(min-width: 768px) 25vw, 80vw', alt: card_title
                                        }}
                                    {% else %}
                                        {{ 'collection-1' | placeholder_svg_tag }}
                                    {% endif %}
                                </div>
                                <div class="trop-link">
                                    <a href="{{ card_link | default: '#' }}" class="trop-card-link trop-flex" {{ block.shopify_attributes }}>
                                        <span>{{ card_text }}</span>
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 17L17 7" stroke="#FFB302" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 7H17V17" stroke="#FFB302" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </a>
                                </div>
                            </div>

                            {% if s.label_position == 'overlay' and card_title != blank %}
                                <span class="{{ label_class }}">{{ card_title }}</span>
                                <p class="{{ label_class }}">{{ card_description }}</p>
                            {% endif %}
                        </div>

                        <div class="trop-collection-list__content-wrap">
                            {% if s.label_position == 'below' and card_title != blank %}
                                <span class="{{ label_class }}">{{ card_title }}</span>
                                {% comment %} <p class="{{ label_class }}">{{ card_description }}</p> {% endcomment %}
                                <p>{{ card_description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        </div>

        <div class="trop-collection-list__header trop-collection-list__header--bottom trop-flex mt-25">
        {% if s.arrow_position == 'bottom' and s.layout_style == 'carousel' and s.enable_arrows %}
            <div class="trop-collection-list__nav">
            <button type="button" class="{{ arrow_shape_class }}" data-trop-prev aria-label="Previous">
                <svg viewBox="0 0 24 24"><path d="M15.5 4.5 8 12l7.5 7.5 1.5-1.5L11 12l6-6z"/></svg>
            </button>
            <button type="button" class="{{ arrow_shape_class }}" data-trop-next aria-label="Next">
                <svg viewBox="0 0 24 24"><path d="M8.5 4.5 16 12l-7.5 7.5L7 18l6-6-6-6z"/></svg>
            </button>
            </div>
        {% endif %}
        </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function initTropCollectionList(section) {
      if (!section) return;

      var track = section.querySelector('[data-trop-track]');
      var prevBtn = section.querySelector('[data-trop-prev]');
      var nextBtn = section.querySelector('[data-trop-next]');
      if (!track) return;

      function scrollAmount() {
        var card = track.querySelector('.trop-collection-list__card');
        var gap = parseInt(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0, 10) || 0;
        return card ? card.getBoundingClientRect().width + gap : 300;
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = track.scrollWidth - track.clientWidth - 1;
        prevBtn.disabled = track.scrollLeft <= 0;
        nextBtn.disabled = track.scrollLeft >= maxScroll;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateArrows);
      window.addEventListener('resize', updateArrows);
      updateArrows();
    }

    function trop_initSection_{{ section.id | replace: '-', '_' }}() {
      var section = document.querySelector('.trop-collection-list-{{ section.id }}');
      initTropCollectionList(section);
    }

    trop_initSection_{{ section.id | replace: '-', '_' }}();

    document.addEventListener('shopify:section:load', function (event) {
      var reloadedSection = event.target.querySelector('.trop-collection-list-{{ section.id }}');
      if (reloadedSection) {
        initTropCollectionList(reloadedSection);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Why Choose Us",
  "class": "trop-why-choose-us-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "carousel", "label": "Carousel (scrollable)" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Section Width",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "no-container", "label": "Full Width" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "cards_width",
      "label": "Cards List Width",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "container",
      "info": "Full Width Option bleeds the row to the right edge of the screen while keeping it aligned with the heading on the left."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop, Grid only)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_style == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile, Grid only)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "visible_if": "{{ section.settings.layout_style == 'grid' }}"
    },
    {
      "type": "range",
      "id": "item_width_desktop",
      "label": "Card Width (Desktop, Carousel only)",
      "min": 150,
      "max": 500,
      "step": 10,
      "default": 300,
      "unit": "px",
      "visible_if": "{{ section.settings.layout_style == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "item_width_mobile",
      "label": "Card Width (Mobile, Carousel only)",
      "min": 120,
      "max": 350,
      "step": 10,
      "default": 220,
      "unit": "px",
      "visible_if": "{{ section.settings.layout_style == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap Between Cards",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Top Padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Bottom Padding",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Sub Heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Why Choose"
    },
    {
      "type": "select",
      "id": "sub_heading_tag",
      "label": "Sub Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "p" }
      ],
      "default": "p"
    },
    {
      "type": "range",
      "id": "sub_heading_size",
      "label": "Sub Heading Font Size",
      "min": 12,
      "max": 60,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "sub_heading_color",
      "label": "Sub Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "sub_heading_alignment",
      "label": "Sub Heading Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "sub_heading_transform",
      "label": "Sub Heading Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "p" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 12,
      "max": 60,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f2f2f2"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Corner Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Card Heading Style"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Card Heading Position",
      "options": [
        { "value": "below", "label": "Below Image" },
        { "value": "overlay", "label": "Overlay on Image" }
      ],
      "default": "below"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Card Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Card Heading Font Size",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "Card Heading Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "label_transform",
      "label": "Card Heading Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Card Description Style"
    },
    {
      "type": "select",
      "id": "description_position",
      "label": "Card Description Position",
      "options": [
        { "value": "below", "label": "Below Image" },
        { "value": "overlay", "label": "Overlay on Image" }
      ],
      "default": "below"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Card Description Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Card Description Font Size",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "description_font_weight",
      "label": "Card Description Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "description_transform",
      "label": "Card Description Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },

    {
      "type": "header",
      "content": "Navigation Arrows (Carousel only)"
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Enable Arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Arrow Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.enable_arrows == true }}"
    },
    {
      "type": "select",
      "id": "arrow_space",
      "label": "Arrow Space",
      "options": [
        { "value": "flex-start", "label": "Both Start" },
        { "value": "flex-end", "label": "Both End" },
        { "value": "space-between", "label": "Space Between" }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.arrow_position == 'top' }}"
    },
    {
      "type": "select",
      "id": "arrow_bottom_align",
      "label": "Arrow Bottom Align",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "flex-end", "label": "Right" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.arrow_position == 'bottom' }}"
    },
    {
      "type": "select",
      "id": "arrow_style",
      "label": "Arrow Shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "circle",
      "visible_if": "{{ section.settings.enable_arrows == true }}"
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow Button Size",
      "min": 24,
      "max": 64,
      "step": 2,
      "default": 36,
      "unit": "px",
