{{ 'theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign bg_color = 'transparent'
  if s.header_bg_color != blank
    assign bg_color = s.header_bg_color | append: ';'
  endif
  
  assign container_bg_color = 'transparent'
  if s.header_c_bg_color != blank
    assign container_bg_color = s.header_c_bg_color | append: ';'
  endif
-%}

{{ s.menu_item_ffamily | font_face: font_display: 'swap' }}

{% style %}
  .trop-header {
    background-color: {{ bg_color }};
  }
  .trop-header__inner {
    background-color: {{ container_bg_color }};
  }
  .trop-header__menu {
    --trop-menu-gap: {{ s.menu_item_gap | default: 12 }}px;
    --trop-menu-font-family: {{ s.menu_item_ffamily.family }}, {{ s.menu_item_ffamily.fallback_families }};
    --trop-menu-font-size: {{ s.menu_item_fsize | default: 15 }}px;
  }
  .trop-header__menu-item > a,
  .trop-header__icons > a {
    --trop-menu-gap-drodpown: {{ s.menu_item_gap_dropdown | default: 12 }}px;
    --trop-menu-text-color: {{ s.menu_item_color | default: "#000000" }};
    --trop-menu-text-color-hover: {{ s.menu_item_color_hover | default: "#ffffff" }};
  }
{% endstyle %}

<header class="trop-header">
  <div class="{{ section.settings.header_width }} trop-header__inner trop-flex">

    {%- comment -%} Logo {%- endcomment -%}
    <div class="trop-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            loading="eager"
          >
        {%- elsif section.settings.site_title != blank -%}
          <span class="trop-header__logo-text">{{ section.settings.site_title }}</span>
        {%- else -%}
          <span class="trop-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Main menu {%- endcomment -%}
    <nav class="trop-header__nav">
      <ul class="trop-header__menu trop-flex">
        {%- for link in section.settings.menu.links -%}
          <li class="trop-header__menu-item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links != blank -%}
              <ul class="trop-header__submenu">
                {%- for childlink in link.links -%}
                  <li class="{% if childlink.links != blank %}has-dropdown{% endif %}">
                    <a href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>{{ childlink.title }}</a>
                    {%- if childlink.links != blank -%}
                      <ul class="trop-header__submenu">
                        {%- for grandchildlink in childlink.links -%}
                          <li>
                            <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>{{ grandchildlink.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Icons {%- endcomment -%}
    <div class="trop-header__icons trop-flex">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="trop-header__icon trop-header__icon--search" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="trop-header__icon trop-header__icon--account" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="trop-header__icon trop-header__icon--cart" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="trop-header__cart-count">{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "header_width",
      "label": "Header Width",
      "options": [
      {
        "value": "no-container",
        "label": "Full Width"
      },
      {
        "value": "container",
        "label": "Container"
      }
    ],
    "default": "container"
    },
    {
      "type": "text",
      "id": "site_title",
      "label": "Site Title"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "header",
      "content": "Menu Options"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "number",
      "id": "menu_item_gap",
      "label": "Menu Item Gap",
      "default": 12
    },
    {
      "type": "number",
      "id": "menu_item_gap_dropdown",
      "label": "Item Gap between Dropdown Icon",
      "default": 12
    },
    {
      "type": "font_picker",
      "id": "menu_item_ffamily",
      "label": "Menu Font Family",
      "default": "mono"
    },
    {
      "type": "range",
      "id": "menu_item_fsize",
      "label": "Menu Font Size",
      "min": 8,
      "max": 101,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "menu_item_color",
      "label": "Menu Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "menu_item_color_hover",
      "label": "Menu Text Hover Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search icon"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "default": true,
      "label": "Show account icon"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "default": true,
      "label": "Show cart icon"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background Color"
    },
    {
      "type": "color",
      "id": "header_c_bg_color",
      "label": "Header Container Background Color"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}