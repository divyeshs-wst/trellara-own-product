{% doc %}
  Widget: Image
{% enddoc %}

{%- liquid
  assign s = block.settings
-%}

<div {% render 'wst-attributes', block: block, widget: 'text', extra_class: text_classes, extra_vars: text_vars %}>
  {%- if s.content_mode == 'code' -%}
    {{ s.custom_html }}
  {%- else -%}
    {{ s.text }}
  {%- endif -%}
</div>

{% stylesheet %}

{% endstylesheet %}

{% schema %}
{
  "name": "media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "content_type",
      "label": "Content Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image",
      "visible_if": "{{ block.settings.content_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "visible_if": "{{ block.settings.content_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video",
      "visible_if": "{{ block.settings.content_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "justify",
          "label": "Justified"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "Use custom text size",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2.2,
      "step": 0.1,
      "default": 1.6,
      "visible_if": "{{ block.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "columns_count",
      "label": "Text columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Text flows into multiple columns on desktop."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Text column gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ block.settings.columns_count > 1 }}"
    },
    {
      "type": "checkbox",
      "id": "drop_cap",
      "label": "Show drop cap",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background color",
      "default": "linear-gradient(90deg, #ffffff 0%, #ffffff 100%)"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background image position",
      "options": [
        {
          "value": "top left",
          "label": "Top left"
        },
        {
          "value": "top center",
          "label": "Top center"
        },
        {
          "value": "top right",
          "label": "Top right"
        },
        {
          "value": "center left",
          "label": "Center left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center right",
          "label": "Center right"
        },
        {
          "value": "bottom left",
          "label": "Bottom left"
        },
        {
          "value": "bottom center",
          "label": "Bottom center"
        },
        {
          "value": "bottom right",
          "label": "Bottom right"
        }
      ],
      "default": "center center",
      "visible_if": "{{ block.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background image size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "Background image repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        }
      ],
      "default": "no-repeat",
      "visible_if": "{{ block.settings.background_image != blank }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Background overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_spacing",
      "label": "Use custom mobile spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.custom_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.custom_mobile_spacing }}"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#121212",
      "visible_if": "{{ block.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in"
        },
        {
          "value": "fade-up",
          "label": "Fade up"
        },
        {
          "value": "fade-down",
          "label": "Fade down"
        },
        {
          "value": "fade-left",
          "label": "Fade left"
        },
        {
          "value": "fade-right",
          "label": "Fade right"
        },
        {
          "value": "zoom-in",
          "label": "Zoom in"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "animation_duration",
      "label": "Animation speed",
      "options": [
        {
          "value": "fast",
          "label": "Fast"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "slow",
          "label": "Slow"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.animation != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "Animation delay",
      "min": 0,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation != 'none' }}"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "info": "Add your own class names, separated by spaces."
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID",
      "info": "Optional anchor, for example to link to this element from a menu."
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
