{% doc %}
  @prompt
    Icon picker option and show icon, Icon select option is not correct. It should be proper icon option that I can select any icon., It looks like very odd, can we use any font icon library and make it better field.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-display-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-icon-wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    {% if block.settings.show_shadow %}
      box-shadow: 0 {{ block.settings.shadow_size }}px {{ block.settings.shadow_size | times: 2 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% endif %}
    transition: all 0.3s ease;
  }

  .ai-icon-wrapper-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    transform: scale({{ block.settings.hover_scale }});
  }

  .ai-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-icon-wrapper-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.hover_icon_color }};
  }
{% endstyle %}

