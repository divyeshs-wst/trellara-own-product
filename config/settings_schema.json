[
  {
    "name": "theme_info",
    "theme_name": "Trellara",
    "theme_version": "0.1.0",
    "theme_author": "Trellara",
    "theme_documentation_url": "https://trellara.example.com/docs",
    "theme_support_url": "https://trellara.example.com/support"
  },
  {
    "name": "t:settings.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings.brand.logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon",
        "info": "t:settings.brand.favicon_info"
      }
    ]
  },
  {
    "name": "t:settings.color.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.color.background",
            "default": "#ffffff"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings.color.background_gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings.color.text",
            "default": "#1a1a1a"
          },
          {
            "type": "color",
            "id": "heading",
            "label": "t:settings.color.heading",
            "default": "#111111"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.color.button_background",
            "default": "#1a1a1a"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.color.button_label",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings.color.border",
            "default": "#e5e5e5"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "links": "button",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "border"
        }
      }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headings_header"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "t:settings.typography.font_heading",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_heading_weight",
        "label": "t:settings.typography.font_heading_weight",
        "min": 300,
        "max": 900,
        "step": 100,
        "default": 700
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "t:settings.typography.letter_spacing",
        "min": -5,
        "max": 10,
        "step": 1,
        "unit": "t:settings.units.hundredth_em",
        "default": 0
      },
      {
        "type": "range",
        "id": "heading_line_height",
        "label": "t:settings.typography.line_height",
        "min": 0.8,
        "max": 2,
        "step": 0.1,
        "default": 1.2
      },
      {
        "type": "header",
        "content": "t:settings.typography.body_header"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings.typography.font_body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_line_height",
        "label": "t:settings.typography.line_height",
        "min": 1,
        "max": 2.4,
        "step": 0.1,
        "default": 1.6
      },
      {
        "type": "header",
        "content": "t:settings.typography.scale_header"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "t:settings.typography.font_size_base",
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "select",
        "id": "type_scale_ratio",
        "label": "t:settings.typography.type_scale_ratio",
        "info": "t:settings.typography.type_scale_ratio_info",
        "options": [
          { "value": "1.125", "label": "t:settings.typography.scale_minor_second" },
          { "value": "1.2", "label": "t:settings.typography.scale_minor_third" },
          { "value": "1.25", "label": "t:settings.typography.scale_major_third" },
          { "value": "1.333", "label": "t:settings.typography.scale_perfect_fourth" },
          { "value": "1.414", "label": "t:settings.typography.scale_augmented_fourth" },
          { "value": "1.5", "label": "t:settings.typography.scale_perfect_fifth" }
        ],
        "default": "1.25"
      }
    ]
  },
  {
    "name": "t:settings.spacing.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.spacing.info"
      },
      {
        "type": "range",
        "id": "spacing_base",
        "label": "t:settings.spacing.base",
        "info": "t:settings.spacing.base_info",
        "min": 2,
        "max": 12,
        "step": 1,
        "unit": "px",
        "default": 4
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "header",
        "content": "t:settings.layout.padding_header"
      },
      {
        "type": "range",
        "id": "container_padding_desktop",
        "label": "t:settings.layout.padding_desktop",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "container_padding_tablet",
        "label": "t:settings.layout.padding_tablet",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "container_padding_mobile",
        "label": "t:settings.layout.padding_mobile",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "t:settings.buttons.name",
    "settings": [
      {
        "type": "select",
        "id": "button_default_style",
        "label": "t:settings.buttons.default_style",
        "options": [
          { "value": "solid", "label": "t:settings.buttons.style_solid" },
          { "value": "outline", "label": "t:settings.buttons.style_outline" },
          { "value": "text", "label": "t:settings.buttons.style_text" }
        ],
        "default": "solid"
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "t:settings.buttons.radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "button_border_width",
        "label": "t:settings.buttons.border_width",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "px",
        "default": 1
      }
    ]
  },
  {
    "name": "t:settings.animation.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "t:settings.animation.enabled",
        "info": "t:settings.animation.enabled_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.social.name",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "https://instagram.com/shop"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "info": "https://facebook.com/shop"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X (Twitter)"
      }
    ]
  }
]
